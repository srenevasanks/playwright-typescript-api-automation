{
  "openapi": "3.1.0",
  "info": {
    "title": "TaskDesk on PocketBase",
    "version": "1.0.0",
    "description": "Controlled task management configuration on unmodified PocketBase 0.40.6. Text is not implicitly trimmed. Role, ownership and archive rules are defined in pb_migrations. No nullable domain fields: optional notes default to an empty string. PATCH only; unsupported PUT returns 404 via upstream catch-all. Token expiry and revocation are not customized."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8090"
    }
  ],
  "security": [
    {
      "Token": []
    }
  ],
