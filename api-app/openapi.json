  "components": {
    "securitySchemes": {
      "Token": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "PocketBase auth token"
      }
    },
    "schemas": {
      "ProjectInput": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 3,
            "maxLength": 80
          },
          "status": {
            "type": "string",
            "enum": ["active", "archived"]
          },
          "owner": {
            "type": "string",
            "pattern": "^[a-z0-9]{15}$"
          }
        },
        "required": ["title", "status", "owner"]
      },
      "ProjectPatch": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 3,
            "maxLength": 80
          },
          "status": {
            "type": "string",
            "enum": ["active", "archived"]
          },
          "owner": {
            "type": "string",
            "pattern": "^[a-z0-9]{15}$"
          }
        },
        "required": []
      },
      "Project": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]{15}$"
          },
          "collectionId": {
            "type": "string"
          },
          "collectionName": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "minLength": 3,
            "maxLength": 80
          },
          "status": {
            "type": "string",
            "enum": ["active", "archived"]
          },
          "owner": {
            "type": "string",
            "pattern": "^[a-z0-9]{15}$"
          }
        },
        "required": ["id", "collectionId", "collectionName", "title", "status", "owner"]
      },
      "TaskInput": {
        "type": "object",
