{
  "name": "playwright-typescript-api-automation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API-only regression framework for TaskDesk on PocketBase",
  "scripts": {
    "app:install": "node scripts/install-app.mjs",
    "app:start": "node scripts/start-app.mjs",
    "feasibility": "node scripts/feasibility.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:smoke": "node scripts/run.mjs smoke",
    "test:functional": "node scripts/run.mjs functional",
    "test:negative": "node scripts/run.mjs negative",
    "test:boundary": "node scripts/run.mjs boundary",
    "test:contract": "node scripts/run.mjs contract",
    "test:authentication": "node scripts/run.mjs authentication",
    "test:authorization": "node scripts/run.mjs authorization",
    "test:integration": "node scripts/run.mjs integration",
    "test:workflows": "node scripts/run.mjs workflows",
    "test:regression": "node scripts/run.mjs regression",
    "test:report": "node scripts/report.mjs"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "^3.15.0",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "zod": "^4.6.7"
  }
}
